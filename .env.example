# Display name in the nav, footer, and page titles.
NEXT_PUBLIC_SITE_NAME=@FindMe

# Listen address for `npm run dev` / `npm start`. HOST_IP / HOST_PORT are aliases.
HOST=127.0.0.1
PORT=3000

# Comma-separated certrelay URLs. Unset = fabric-web public seeds.
# FABRIC_SEEDS=http://127.0.0.1:7778
# FABRIC_SEEDS=https://relay-cosmos.spacesprotocol.org,https://relay-atlas.spacesprotocol.org

# Skip work-depth checks when talking to a local relay that is not yet finalized.
# FABRIC_DEV_MODE=true

# Spaced JSON-RPC (on-chain num / fallback). Use 127.0.0.1, not 0.0.0.0.
SPACED_RPC_URL=http://127.0.0.1:7225
SPACED_RPC_USER=
SPACED_RPC_PASSWORD=
SPACED_CHAIN=mainnet
